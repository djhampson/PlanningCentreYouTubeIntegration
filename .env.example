# Planning Center API Credentials
# Get your Personal Access Token from: https://api.planningcenteronline.com/oauth/applications
PLANNING_CENTER_APP_ID=your_app_id_here
PLANNING_CENTER_SECRET=your_secret_here

# Planning Center Configuration
PLANNING_CENTER_ORG_ID=your_organization_id
PLANNING_CENTER_SERVICE_TYPE_ID=your_service_type_id

# YouTube API Credentials
# Set up OAuth 2.0 credentials at: https://console.cloud.google.com/
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json

# YouTube Stream Settings
YOUTUBE_PRIVACY_STATUS=public  # Options: public, unlisted, private
YOUTUBE_STREAM_ID=  # Optional: reuse an existing stream key (leave blank to create a new reusable stream on first run)

# Service Configuration
CHURCH_NAME=Southside Anglican
SERVICE_TIME=16:00  # 4pm in 24-hour format
TIMEZONE=Australia/Sydney
